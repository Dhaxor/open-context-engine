{
  "name": "@dhaxor/open-context",
  "version": "0.4.7",
  "description": "Local-first code retrieval and coding agent \u2014 hybrid semantic + keyword search over your codebase, served to any AI over MCP. Runs fully offline.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "oce": "dist/cli/index.js"
  },
  "license": "MIT",
  "author": "Gain (https://github.com/dhaxor)",
  "homepage": "https://opencontextengine.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dhaxor/open-context-engine.git"
  },
  "bugs": {
    "url": "https://github.com/Dhaxor/open-context-engine/issues"
  },
  "keywords": [
    "code-search",
    "semantic-search",
    "embeddings",
    "rag",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "coding-agent",
    "tree-sitter",
    "sqlite-vec",
    "local-first",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.map"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc && npm run build:studio",
    "build:studio": "node build-studio.js --minify",
    "dev": "tsc --watch",
    "dev:studio": "node build-studio.js --watch",
    "desktop": "electron desktop",
    "check:desktop": "node scripts/check-desktop.js",
    "preview:tui": "node scripts/tui-preview.js",
    "release:check": "bash scripts/release-check.sh",
    "typecheck": "npm run typecheck:core && npm run typecheck:extension",
    "test": "npm run test:core && npm run test:extension",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "prepublishOnly": "npm run verify:core",
    "typecheck:core": "tsc --noEmit && tsc -p tsconfig.studio.json",
    "typecheck:extension": "npm --prefix extension run typecheck",
    "test:core": "vitest run",
    "test:extension": "npm --prefix extension run test",
    "verify:core": "npm run typecheck:core && npm run test:core",
    "verify:extension": "npm --prefix extension run verify",
    "verify": "npm run verify:core && npm run verify:extension"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^6.0.0",
    "commander": "^12.0.0",
    "ignore": "^7.0.14",
    "minimatch": "^10.2.6",
    "openai": "^7.43.0",
    "sqlite-vec": "^0.1.9",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "~0.25.10",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cmdk": "^1.1.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
