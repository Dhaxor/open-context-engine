# Dependencies
node_modules/
extension/node_modules/
desktop/node_modules/
# package-lock.json is the tracked lockfile — every CI job runs `npm ci`.
# Installing with another package manager writes a second lockfile that then
# drifts silently from it, so those are ignored rather than committed.
pnpm-lock.yaml
yarn.lock

# Build output
dist/
*.tsbuildinfo

# Local data stores (generated by indexing)
.open-context/

# Environment / secrets

# Internal commercialization docs + license SIGNING KEYS (never commit; keep private)
business/

# Commercial edition (proprietary). Keep OUT of the public repo — track it in a private
# repo instead (see ee/README.md). Comment this out if THIS repo is your private one.
ee/

# Billing webhook infra (private money plumbing; deploy + version separately).
billing/

# Debug & scratch files
debug-*.js
debug-*.ts
scratch/
# Local operator scripts (_check_ci.sh, _claude_*.sh, …). These are personal
# workflow helpers, never product code — and `files` in package.json keeps them
# out of the npm tarball regardless.
_*.sh
_*.py
_*.mjs
_*.json
_*.txt

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/settings.json
.vscode/launch.json
.idea/
# Local agent tooling state (preview launch config, local settings, scratch media)
.claude/

# Desktop app packaging output
desktop/release/
*.swp
*.swo

# Test coverage
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
dist-native/

# webview dev harness (generated)
extension/dev/harness.html
extension/dev/_chat-html.cjs

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

.projects/cache
.projects/vault
.projects/state.test.json
.projects/state.local.test.json
.env
.env.*
!.env.example
