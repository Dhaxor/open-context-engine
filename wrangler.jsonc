{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-context-engine",
  "main": "worker.ts",
  "compatibility_date": "2026-07-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "web",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
