{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-context-engine",
  "main": "worker.ts",
  "compatibility_date": "2026-07-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "web",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "ACTIVATE_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 20, "period": 60 }
      }
    ]
  }
}
