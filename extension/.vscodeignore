# Source — only the built dist/ ships.
.vscode/**
src/**
tsconfig.json
*.map
node_modules/.package-lock.json
node_modules/.cache/**
node_modules/.bin/**

# Backup files a native rebuild can leave behind. Never ship these or the
# extension may load the wrong binary at runtime.
**/*.node.bak

# Build tooling only needed at publish time — keep them out of the VSIX.
node_modules/@vscode/vsce/**
node_modules/typescript/**
node_modules/esbuild/**
scripts/**

# Per-ABI bindings from before 0.4 (gitignored; may linger in old checkouts).
# Shipping them would only add dead weight — verify-vsix.mjs fails on them.
dist-native/**

# better-sqlite3 13 is Node-API: its package carries a prebuild for all eight
# platforms, plus the C++ sources and SQLite amalgamation for source builds.
# A VSIX needs only its own target's prebuild, which scripts/package-vsix.mjs
# re-includes with a single negation. build/ is what `npm ci`'s node-gyp step
# leaves behind: lockfiles don't record the package's `"gypfile": false`, so
# npm runs it, and binding.gyp turns it into a no-op when a prebuild exists.
node_modules/better-sqlite3/prebuilds/**
node_modules/better-sqlite3/deps/**
node_modules/better-sqlite3/src/**
node_modules/better-sqlite3/build/**
node_modules/better-sqlite3/binding.gyp

# Documentation that belongs on GitHub, not in the runtime bundle.
CHANGELOG.md
PUBLISHING.md
dev/**

# Build-time-only renderer deps: markdown-it + highlight.js are bundled INTO
# dist/webview.js by esbuild — dist/extension.js never references them
# (verified by verify-vsix.mjs's runtime-require check). ~12 MB.
node_modules/highlight.js/**
node_modules/@types/markdown-it/**
node_modules/markdown-it/**
node_modules/argparse/**
node_modules/entities/**
node_modules/linkify-it/**
node_modules/mdurl/**
node_modules/uc.micro/**
node_modules/punycode.js/**

# tree-sitter-wasms ships ~40 language grammars (~50 MB); the engine can only
# ever request the 14 in languageForPath (src/core/ast-graph-shared.ts). Keep
# that list in sync — verify-vsix.mjs asserts exactly these 14 ship.
node_modules/tree-sitter-wasms/out/*.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-typescript.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-tsx.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-javascript.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-python.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-go.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-rust.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-java.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-c_sharp.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-c.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-cpp.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-ruby.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-php.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-kotlin.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-swift.wasm

# IMPORTANT: keep the native modules in. Without these explicit negations a
# future broad ignore (e.g. node_modules/*) would silently strip them and we'd
# be back to "first index throws on a paying customer". better-sqlite3 is
# negated narrowly (not `/**`) so the prebuild and source excludes above hold.
!node_modules/better-sqlite3/package.json
!node_modules/better-sqlite3/lib/**
!node_modules/sqlite-vec/**
!node_modules/sqlite-vec-*/**
!node_modules/web-tree-sitter/**
!node_modules/chokidar/**
!node_modules/openai/**
# tree-sitter-wasms deliberately has NO broad negation — vsce negations are
# not order-sensitive (a `!pkg/**` would re-include every grammar and defeat
# the *.wasm prune above). Only package.json + the 14 grammar negations ship.
!node_modules/tree-sitter-wasms/package.json
