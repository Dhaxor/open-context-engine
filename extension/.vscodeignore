# Source — only the built dist/ ships.
.vscode/**
src/**
tsconfig.json
*.map
node_modules/.package-lock.json
node_modules/.cache/**
node_modules/.bin/**

# Backup files electron-rebuild leaves behind. Never ship these or the
# extension may load the wrong (pre-rebuild) binary at runtime.
**/*.node.bak

# Build tooling only needed at publish time — keep them out of the VSIX.
node_modules/@electron/rebuild/**
node_modules/@vscode/vsce/**
node_modules/electron/**
node_modules/typescript/**
node_modules/esbuild/**
scripts/**

# Documentation that belongs on GitHub, not in the runtime bundle.
CHANGELOG.md
PUBLISHING.md
dev/**

# Build-time-only renderer deps: markdown-it + highlight.js are bundled INTO
# dist/webview.js by esbuild — dist/extension.js never references them
# (verified by verify-vsix.mjs's runtime-require check). ~12 MB.
node_modules/highlight.js/**
node_modules/@types/markdown-it/**
node_modules/markdown-it/**
node_modules/argparse/**
node_modules/entities/**
node_modules/linkify-it/**
node_modules/mdurl/**
node_modules/uc.micro/**
node_modules/punycode.js/**

# tree-sitter-wasms ships ~40 language grammars (~50 MB); the engine can only
# ever request the 8 in languageForPath (src/core/ast-graph-shared.ts). Keep
# that list in sync — verify-vsix.mjs asserts exactly these 8 ship.
node_modules/tree-sitter-wasms/out/*.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-typescript.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-tsx.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-javascript.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-python.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-go.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-rust.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-java.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-c_sharp.wasm

# IMPORTANT: keep the native bindings in. Without these explicit negations a
# future broad ignore (e.g. node_modules/*) would silently strip the .node and
# we'd be back to "first index throws on a paying customer".
# dist-native/ holds one better_sqlite3.node per supported Electron ABI; the
# runtime selector copies the matching one into better-sqlite3 at activation.
!dist-native/**
!node_modules/better-sqlite3/**
!node_modules/sqlite-vec/**
!node_modules/sqlite-vec-*/**
!node_modules/web-tree-sitter/**
!node_modules/chokidar/**
!node_modules/openai/**
# tree-sitter-wasms deliberately has NO broad negation — vsce negations are
# not order-sensitive (a `!pkg/**` would re-include every grammar and defeat
# the *.wasm prune above). Only package.json + the 8 grammar negations ship.
!node_modules/tree-sitter-wasms/package.json
