{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022"
    ],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [
      "vscode",
      "node"
    ],
    "rootDir": ".."
  },
  "include": [
    "src/**/*",
    "../../src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../../node_modules",
    "../../dist",
    "src/**/*.test.ts",
    "test/**/*",
    "src/shared/webview/render.ts",
    "src/shared/webview/styles.css",
    "src/agent-ui/**/*"
  ]
}