# Cloudflare Workers static-asset headers (not served itself).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

# The stylesheet is linked as /oce.css?v=<release>; a day keeps edits between
# releases from going stale for long.
/oce.css
  Cache-Control: public, max-age=86400
/site.js
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/logo.png
  Cache-Control: public, max-age=604800
/og-image.png
  Cache-Control: public, max-age=86400
/og/*
  Cache-Control: public, max-age=86400
/img/*
  Cache-Control: public, max-age=604800
