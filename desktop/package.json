{
  "name": "@open-context-engine/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Trace — the Open Context Engine agent workspace as a desktop app.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3 -m ..",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "42.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.opencontextengine.trace",
    "productName": "Trace",
    "directories": { "output": "release" },
    "files": [
      "main.js",
      "preload.js",
      "../dist/**/*",
      "!../dist/**/*.map",
      "!../dist/**/*.test.js"
    ],
    "extraMetadata": { "main": "main.js" },
    "mac": { "category": "public.app-category.developer-tools", "target": ["dmg", "zip"] },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage", "deb"], "category": "Development" }
  }
}
